// Digital business card for the M5StickS3
//
// Switch it on:
//   - Instagram QR code, then the flying-kick figure, over and over
//   - press nothing for 30 seconds and it switches itself off
//
// While it is on:
//   - big front button      -> Telegram QR code
//   - small side button     -> LinkedIn QR code
//   - shake the stick       -> website QR code
//   A QR code stays for one minute, then the stick switches itself off.
//   While a QR is showing, a button or a shake jumps straight to that other QR.
//
// Getting back to the loop from a QR code:
//   - hold either button for about half a second, or
//   - if the website QR is showing, shake again
//
// Arduino IDE: board = M5StickS3 (M5Stack package), library = M5Unified.

#include <M5Unified.h>
#include <esp_sleep.h>

// ---------- Things you can change ----------
const char* igLink     = "https://instagram.com/YOUR_USERNAME";
const char* igLabel    = "INSTAGRAM";
const char* igSmall    = "@your_username";

const char* tgLink     = "https://t.me/YOUR_USERNAME";
const char* tgLabel    = "TELEGRAM";
const char* tgSmall    = "@your_username";

const char* liLink     = "https://linkedin.com/in/YOUR_PROFILE";
const char* liLabel    = "LINKEDIN";
const char* liSmall    = "Your Name";

const char* webLink    = "https://www.YOUR-WEBSITE.com";
const char* webLabel   = "WEBSITE";
const char* webSmall   = "your-website.com";

const int   screenTurn = 1;        // 1 = sideways. If the picture is upside down, change to 3
const int   nameTime   = 3000;     // ms the Instagram QR stays on screen in the loop
const int   kickHold   = 1200;     // ms the figure stops in the middle
const int   slideStep  = 5;        // pixels the figure moves per frame (bigger = faster)
const int   frameTime  = 25;       // ms per frame

const unsigned long loopOffTime = 30000;   // ms of loop with no press before it switches off
const unsigned long qrOffTime   = 60000;   // ms a QR code stays before it switches off

const float shakeStrength = 2.3;   // how hard a shake must be. Bigger = harder. Try 1.8 to 3.0
const bool  clickSound    = true;  // short click on button presses. false = silent
const int   clickVolume   = 90;    // 0 to 255. Keep under 190 on battery
const int   clickLength   = 120;   // ms the click lasts. Shorter than about 80 can go silent
const int   holdTime      = 600;   // ms a button must be held to count as a long press

